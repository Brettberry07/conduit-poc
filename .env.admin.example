# LOCAL KEY ADMINISTRATION ONLY. Copy to .env.admin.local (mode 600).
# Hosted deployment uses a restricted conduit_key_admin login for key create/list/revoke.
# Never configure this value in Vercel, Instinct, or the worker.
ADMIN_DATABASE_URL=postgresql://conduit_key_admin.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres
DATABASE_SSL=true
# DATABASE_CA_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# For schema migrations/runtime provisioning use .env.schema-admin.example and CONDUIT_ADMIN_ENV_FILE.
