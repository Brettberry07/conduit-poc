# Optional schema/runtime provisioning administrator, LOCAL ONLY.
# Copy to .env.schema-admin.local (mode 600) and supply your own dedicated-project postgres credential.
# Use CONDUIT_ADMIN_ENV_FILE=.env.schema-admin.local for db:migrate / db:runtime.
ADMIN_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres
DATABASE_SSL=true
# DATABASE_CA_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
