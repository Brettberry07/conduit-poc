# Only these values are needed on the Mac worker. No database credentials.
CONDUIT_API_URL=https://YOUR-PROJECT.vercel.app
WORKER_KEY_FILE=.secrets/worker.json
# Keep separate state for the hosted queue; do not reuse a local queue's journal.
WORKER_STATE_DIR=.worker/hosted-mac-worker
# Actual execution requires Node 24 and a file-backed `codex login` (ChatGPT).
# This overrides only the authenticated CLI home used to read auth.json; never point it at a project.
# CODEX_HOME=/Users/YOU/.codex
# Default 180000; allowed range 1000..600000 milliseconds. Verification: 30s per check.
CODEX_TIMEOUT_MS=180000
# Optional account-supported model; otherwise Codex uses its default.
# CONDUIT_CODEX_MODEL=YOUR_MODEL
# Phase 4 only: administrator-owned project registry and private GitHub token.
# No local paths or GitHub credentials are accepted through ordinary job requests.
# CONDUIT_PROJECTS_FILE=/Users/YOU/Conduit/config/projects.json
# CONDUIT_GITHUB_TOKEN_FILE=/Users/YOU/Conduit/secrets/github-token
# Optional read-only administrator audit token (Administration read + Metadata only),
# needed when GitHub hides ruleset bypass actors from the push-only bot.
# CONDUIT_GITHUB_POLICY_TOKEN_FILE=/Users/YOU/Conduit/secrets/github-policy-read-token
