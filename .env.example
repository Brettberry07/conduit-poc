# Vercel/runtime only. Copy to .env.local for local Next.js development.
# Hosted: use Supabase transaction-pooler URL for conduit_runtime, port 6543.
DATABASE_URL=postgresql://conduit_runtime.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres
DATABASE_SSL=true
# Phase 5A: enable only after Instinct sends the current manifest policy_version.
CONDUIT_ENFORCE_POLICY_VERSION=false
# Optional project CA certificate PEM; never disable TLS verification.
# DATABASE_CA_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
