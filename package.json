{
  "name": "conduit-poc",
  "version": "1.0.0",
  "description": "Standalone leased queue and communication proof of concept",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "worker": "tsx worker/index.ts",
    "key": "tsx scripts/key.ts",
    "db:local": "tsx scripts/local-db.ts",
    "format": "prettier --write src worker scripts tests docs README.md package.json tsconfig.json",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:runtime": "tsx scripts/runtime-role.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test:http": "tsx --test tests/http.test.ts",
    "smoke:codex": "tsx scripts/codex-smoke.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@openai/codex-sdk": "0.166.0",
    "@vercel/functions": "3.10.6",
    "dotenv": "18.0.9",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "18.6.0-beta.19",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "private": true,
  "engines": {
    "node": "24.x"
  }
}
